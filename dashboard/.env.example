# Default API path: same-origin Caddy -> Go Gateway.
VITE_API_MODE=go
# Optional edge-first mode: set VITE_API_MODE=cloudflare to enable this URL.
VITE_EDGE_URL=https://detroit-go-gateway.arborrr.workers.dev
# Firebase config (copy to .env and fill in real values)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=1:your-project:web:your-app-id
