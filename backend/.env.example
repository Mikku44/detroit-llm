SGLANG_URL=http://localhost:30000
# PostgreSQL (recommended). For local dev you can still use SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./gateway.db
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/detroit
# Separate DB for chat history (can point at the same server, different schema/db).
CONVERSATIONS_DB_URL=postgresql+asyncpg://user:password@localhost:5432/detroit_conversations

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_API_KEY=your-youtube-data-api-key

OWNER_GOOGLE_EMAIL=your-channel-owner-email@gmail.com
OWNER_REFRESH_TOKEN=initial-owner-refresh-token

JWT_SECRET=generate-a-random-secret-here-at-least-32-chars
JWT_ALGORITHM=HS256
# Optional: separate key for encrypting sensitive DB values (raw API keys) at rest.
# If unset, derived from JWT_SECRET. Set a random 32+ char value if you want to
# rotate JWT_SECRET without losing access to stored keys.
# ENCRYPTION_KEY=generate-another-random-secret-here-at-least-32-chars

DASHBOARD_URL=http://localhost:5173
REDIRECT_URI=http://localhost:8000/auth/youtube/callback

RATE_LIMIT_PER_MINUTE=60

# Free-tier weekly/monthly total-token budget (input + output).
# Owner/member tiers are unlimited.
FREE_WEEKLY_TOKENS=100000
FREE_MONTHLY_TOKENS=435000

# DeepSeek: text chat proxy upstream
DEEPSEEK_API_KEY=your-deepseek-api-key

# Alibaba Cloud DashScope (international) — Qwen models (qwen3.7-flash etc.)
# Get a key from https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=your-dashscope-api-key

# OpenRouter — stealth/ox-alpha etc. Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Gemini: vision upstream (required for image/chat uploads). Get a key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta

# Image generation provider: "auto" (dashscope -> unsplash -> loremflickr -> mock) | "dashscope" | "unsplash" | "loremflickr" | "mock" (offline)
# "dashscope" uses z-image-turbo for real AI image generation (needs DASHSCOPE_API_KEY above).
IMAGE_PROVIDER=auto
# Get an access key from https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Stripe payment for paid tiers (Nomad/Dreamer/Entrepreneur/Angel)
STRIPE_API_KEY=your-stripe-restricted-or-secret-key
# Secret for verifying Stripe webhooks (checkout.session.completed etc).
# Create the webhook endpoint at https://dashboard.stripe.com/webhooks pointing
# to https://your-domain/stripe/webhook with events:
#   checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-signing-secret
