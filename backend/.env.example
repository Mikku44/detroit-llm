SGLANG_URL=http://localhost:30000
DATABASE_URL=sqlite+aiosqlite:///./gateway.db

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_API_KEY=your-youtube-data-api-key

OWNER_GOOGLE_EMAIL=your-channel-owner-email@gmail.com
OWNER_REFRESH_TOKEN=initial-owner-refresh-token

JWT_SECRET=generate-a-random-secret-here
JWT_ALGORITHM=HS256

DASHBOARD_URL=http://localhost:5173
REDIRECT_URI=http://localhost:8000/auth/youtube/callback

RATE_LIMIT_PER_MINUTE=60

# DeepSeek: text chat proxy upstream
DEEPSEEK_API_KEY=your-deepseek-api-key

# Gemini: vision upstream (required for image/chat uploads). Get a key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta

# Image generation provider: "loremflickr" (default, free, no key) | "unsplash" (needs access key) | "auto" | "mock" (offline)
# "auto" tries unsplash -> loremflickr -> mock.
IMAGE_PROVIDER=loremflickr
# Get an access key from https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
