{
    email {$ACME_EMAIL}
    acme_ca https://acme-v02.api.letsencrypt.org/directory
}

{$DOMAIN:chat.khain.app} {
    encode gzip
    root * /srv

    # ============================================================
    # Rate limiting
    # ============================================================
    rate_limit {
        # General API endpoints
        zone static {
            match {
                path /v1/* /admin/* /api/conversations* /api/web/* /api/*
            }
            key {remote_host}
            window 1m
            events 60
        }

        # Health check
        zone health {
            match {
                path /health
            }
            key {remote_host}
            window 1m
            events 30
        }

        # Authentication / payment endpoints
        zone auth {
            match {
                path /auth/* /stripe/*
            }
            key {remote_host}
            window 1m
            events 20
        }
    }

    # ============================================================
    # Go Gateway
    # ============================================================

    handle /v1/* {
        reverse_proxy go-gateway:8080 {
            lb_try_duration 2s
            lb_try_interval 100ms
        }
    }

    handle /health {
        reverse_proxy go-gateway:8080 {
            lb_try_duration 2s
        }
    }

    handle /admin/* {
        reverse_proxy go-gateway:8080 {
            lb_try_duration 2s
            lb_try_interval 100ms
        }
    }

    handle /api/conversations* {
        reverse_proxy go-gateway:8080 {
            lb_try_duration 2s
        }
    }

    handle /api/web/* {
        reverse_proxy go-gateway:8080 {
            lb_try_duration 2s
        }
    }

    # ============================================================
    # FastAPI Backend
    # ============================================================

    handle /api/* {
        reverse_proxy backend:8000
    }

    # ============================================================
    # Auth / Stripe
    # ============================================================

    handle /auth/* {
        reverse_proxy go-gateway:8080 {
            lb_try_duration 2s
        }
    }

    handle /stripe/* {
        reverse_proxy go-gateway:8080 {
            lb_try_duration 2s
        }
    }

    # ============================================================
    # Frontend
    # ============================================================

    handle {
        try_files {path} /index.html
        file_server
    }
}