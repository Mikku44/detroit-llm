{
	email {$ACME_EMAIL}
}

{$DOMAIN:chat.khain.app} {
	encode gzip
	root * /srv

	# Go edge gateway (Tier A+B) — rate limit, models cache, admin read, streaming passthrough
	handle /v1/* {
		reverse_proxy go-gateway:8080 {
			lb_try_duration 2s
			lb_try_interval 100ms
		}
	}
	handle /health {
		reverse_proxy go-gateway:8080 {
			lb_try_duration 2s
		}
	}
	handle /admin/* {
		reverse_proxy go-gateway:8080 {
			lb_try_duration 2s
			lb_try_interval 100ms
		}
	}

	# Go handles conversations read directly (pg-only) + web chat image_gen injection
	handle /api/conversations* {
		reverse_proxy go-gateway:8080 {
			lb_try_duration 2s
		}
	}
	handle /api/web/* {
		reverse_proxy go-gateway:8080 {
			lb_try_duration 2s
		}
	}
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /auth/* {
		reverse_proxy backend:8000
	}
	handle /stripe/* {
		reverse_proxy backend:8000
	}
	# SPA: serve existing files, fall back to index.html
	handle {
		try_files {path} /index.html
		file_server
	}
}
