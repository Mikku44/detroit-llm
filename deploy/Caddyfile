{
    email {$ACME_EMAIL}
    acme_ca https://acme-v02.api.letsencrypt.org/directory
}

{$DOMAIN:chat.khain.app} {
    encode gzip
    root * /srv

    handle /v1/* {
        reverse_proxy go-gateway:8080 {
            lb_try_duration 2s
            lb_try_interval 100ms
        }
    }

    handle /health {
        reverse_proxy go-gateway:8080 {
            lb_try_duration 2s
        }
    }

    handle /admin/* {
        reverse_proxy go-gateway:8080 {
            lb_try_duration 2s
            lb_try_interval 100ms
        }
    }

    handle /api/conversations* {
        reverse_proxy go-gateway:8080 {
            lb_try_duration 2s
        }
    }

    handle /api/web/* {
        reverse_proxy go-gateway:8080 {
            lb_try_duration 2s
        }
    }

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /auth/* {
        reverse_proxy backend:8000
    }

    handle /stripe/* {
        reverse_proxy backend:8000
    }

    handle {
        try_files {path} /index.html
        file_server
    }
}