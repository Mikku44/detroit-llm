# === Detroit LLM Gateway — Docker deployment env ===
# Copy to deploy/.env and fill in real values.

SGLANG_URL=http://localhost:30000

# --- Databases ---
# Self-hosted Postgres (docker compose --profile selfhosted):
# DATABASE_URL=postgresql+asyncpg://detroit:CHANGE_ME@postgres:5432/detroit
# CONVERSATIONS_DB_URL=postgresql+asyncpg://detroit:CHANGE_ME@postgres:5432/detroit_conversations
# Neon (recommended for proxy + 100 users) — use the pooled endpoint + sslmode=require:
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx-pooler.neon.tech/neondb?sslmode=require
# CONVERSATIONS_DB_URL=postgresql+asyncpg://user:pass@ep-xxx-pooler.neon.tech/neondb?sslmode=require
# Fallback: SQLite on the /data volume (set in docker-compose.yml)
# DATABASE_URL=sqlite+aiosqlite:////data/gateway.db
# CONVERSATIONS_DB_URL=sqlite+aiosqlite:////data/conversations.db

# Persistent runtime data (members.json, owner refresh token). Must match the
# volume mount in docker-compose.yml. Leave as /data.
DATA_DIR=/data

# Postgres credentials (used by the postgres service).
POSTGRES_USER=detroit
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=detroit

# --- Google OAuth (login) ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_API_KEY=your-youtube-data-api-key

# --- Owner (YouTube channel owner) ---
OWNER_GOOGLE_EMAIL=your-channel-owner-email@gmail.com
OWNER_REFRESH_TOKEN=initial-owner-refresh-token

# --- Auth ---
JWT_SECRET=generate-a-long-random-secret-here-at-least-32-chars
JWT_ALGORITHM=HS256
# Optional: separate key for encrypting sensitive DB values (raw API keys) at rest.
# ENCRYPTION_KEY=generate-another-long-random-secret-here

# --- Public URLs (prod) ---
DOMAIN=chat.khain.app
ACME_EMAIL=your-email@example.com
DASHBOARD_URL=https://chat.khain.app
REDIRECT_URI=https://chat.khain.app/auth/youtube/callback

RATE_LIMIT_PER_MINUTE=60

# --- Free-tier token budgets ---
FREE_WEEKLY_TOKENS=100000
FREE_MONTHLY_TOKENS=435000

# --- Upstream LLMs ---
DEEPSEEK_API_KEY=your-deepseek-api-key
DASHSCOPE_API_KEY=your-dashscope-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
Z_API_KEY=your-zai-api-key
Z_AI_URL=https://api.z.ai/api/paas/v4

# Cloudflare R2 — image object storage
R2_ACCOUNT_ID=your-r2-account-id
R2_BUCKET_NAME=detroit-llm-storage
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta

# --- Image provider ---
# "auto" = dashscope (z-image-turbo) -> unsplash -> loremflickr -> mock
IMAGE_PROVIDER=auto
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# --- Stripe (paid tiers) ---
STRIPE_API_KEY=your-stripe-restricted-or-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

# --- YouTube membership page ---
MEMBERS_URL=https://www.youtube.com/@YOURCHANNEL/join
