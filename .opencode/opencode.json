{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "detroit": {
      "id": "detroit",
      "name": "Detroit LLM",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:8000/v1",
        "apiKey": "{env:DETROIT_API_KEY}"
      },
      "models": {
        "deepseek-v4-pro": {
          "id": "deepseek-v4-pro",
          "name": "DeepSeek V4 Pro",
          "reasoning": true,
          "tool_call": true
        },
        "deepseek-v4-flash": {
          "id": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "tool_call": true
        }
      }
    }
  },
  "model": "detroit/deepseek-v4-pro"
}
