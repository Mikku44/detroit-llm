{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "detroit-go-gateway",
  "main": "src/cloudflare.js",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "BACKEND_URL": "https://chat.khain.app",
    "DASHBOARD_URL": "https://chat.khain.app",
    "RATE_LIMIT_PER_MINUTE": "60"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GoGatewayContainer"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["GoGatewayContainer"]
    }
  ]
}
